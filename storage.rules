rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    function isAdmin() {
      return isAuthenticated() && (
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'sub_admin', 'staff']
      );
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    match /chat_attachments/{chatId}/{fileName} {
      function participant() {
        let chat = firestore.get(/databases/(default)/documents/chats/$(chatId)).data;
        let user = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
        let permissions = user.get('permissions', []);
        let canChat = user.role == 'admin' || user.role == 'super_admin' ||
          (permissions is list && permissions.hasAny(['chats','manage_chats'])) ||
          (permissions is map && (permissions.get('chats',false) || permissions.get('manage_chats',false)));
        return chat.customerId == request.auth.uid || user.role == 'super_admin' ||
          (canChat && user.get('branchId','') == chat.get('branchId',''));
      }
      allow read: if isAuthenticated() && participant();
      allow create: if isAuthenticated() && participant() && isImage() && request.resource.size < 5 * 1024 * 1024;
      allow update, delete: if isSuperAdmin();
    }

    // Customer profile photos (supports profiles/ and profile_photos/)
    match /profile_photos/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin())
                   && request.resource.size < 5 * 1024 * 1024
                   && isImage();
    }

    match /profiles/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin())
                   && request.resource.size < 5 * 1024 * 1024
                   && isImage();
    }

    match /profiles/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && (fileName.matches('^' + request.auth.uid + '.*') || isAdmin())
                   && request.resource.size < 5 * 1024 * 1024
                   && isImage();
    }

    // Products & Restaurant menu item images
    match /products/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && isImage();
    }

    match /menu_items/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && isImage();
    }

    // Categories images
    match /categories/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && isImage();
    }

    // Banners & Promos
    match /banners/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && isImage();
    }

    // Special Offers
    match /offers/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && isImage();
    }

    // Rider profile documents / photos
    match /riders/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && isImage();
    }

    // User reviews media
    match /reviews/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.resource.size < 5 * 1024 * 1024
                   && isImage();
    }

    // Default deny for unlisted paths unless Super Admin
    match /{allPaths=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
