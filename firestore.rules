rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 0. AUTHENTICATION & SECURE ROLE HELPERS (DO NOT TRUST CLIENT-PROVIDED ROLE)
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function existingUser() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return existingUser() ? getUserData().get('role', '') : '';
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.get('role', '') == 'super_admin') ||
        getUserRole() == 'super_admin'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.token != null && (
          request.auth.token.get('role', '') == 'admin' ||
          request.auth.token.get('role', '') == 'sub_admin' ||
          request.auth.token.get('role', '') == 'staff'
        )) ||
        getUserRole() == 'admin' ||
        getUserRole() == 'sub_admin' ||
        getUserRole() == 'staff'
      );
    }

    function isDeliveryRider() {
      return isAuthenticated() && (
        (request.auth.token != null && (
          request.auth.token.get('role', '') == 'delivery_rider' ||
          request.auth.token.get('role', '') == 'rider'
        )) ||
        getUserRole() == 'delivery_rider' ||
        getUserRole() == 'rider'
      );
    }

    function isSubAdmin() {
      return existingUser() && getUserData().get('parentAdminId', null) != null;
    }

    function hasPermission(perm) {
      return (
        getUserData().get('permissions', null) is list && (
          getUserData().get('permissions', []).hasAny([perm, 'manage_' + perm])
        )
      ) || (
        getUserData().get('permissions', null) is map && (
          getUserData().get('permissions', {}).get(perm, false) == true ||
          getUserData().get('permissions', {}).get('manage_' + perm, false) == true
        )
      );
    }

    function canManage(perm) {
      return isSuperAdmin() || (
        isAdmin() && (
          !isSubAdmin() || hasPermission(perm)
        )
      );
    }

    function incomingRole() {
      return request.resource.data.get('role', '');
    }

    function existingRole() {
      return resource.data.get('role', '');
    }

    function getOrder(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId)).data;
    }

    // =========================================================================
    // 1. BRANCHES & MULTI-LOCATION
    // =========================================================================
    match /branches/{branchId} {
      allow read: if true;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (isAdmin() && getUserData().get('branchId', '') == branchId) || isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 2. RESTAURANTS
    // =========================================================================
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if isSuperAdmin() || canManage('restaurants');
    }

    // =========================================================================
    // 3. USERS & ACCOUNTS (STRICT ROLE PRIVILEGES)
    // =========================================================================
    match /users/{userId} {
      // Read: Users can read their own profile. Admins can read all profiles. Riders can read for assignment details.
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || isDeliveryRider());

      // Create:
      // - Customer self-signup: only allowed with role == 'customer' and no elevated flags
      // - Admin: can create staff/customer, CANNOT create super_admin
      // - Super Admin: full creation rights
      allow create: if (
        isSuperAdmin() ||
        (
          isAdmin() &&
          !isSubAdmin() &&
          incomingRole() != 'super_admin'
        ) ||
        (
          isOwner(userId) &&
          (incomingRole() == 'customer' || incomingRole() == '') &&
          request.resource.data.get('permissions', null) == null &&
          request.resource.data.get('isAdmin', false) == false &&
          request.resource.data.get('isSuperAdmin', false) == false
        )
      );

      // Update:
      // - Super Admin: full update rights
      // - Admin: manage users/staff (cannot modify super_admin, cannot promote to super_admin)
      // - Customer: can update only safe profile fields (cannot change role, status, branch, permissions)
      allow update: if (
        isSuperAdmin() ||
        (
          isAdmin() &&
          (!isSubAdmin() || canManage('customers')) &&
          existingRole() != 'super_admin' &&
          incomingRole() != 'super_admin'
        ) ||
        (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'permissions', 'status', 'isActive', 'isAdmin', 'isSuperAdmin',
            'branchId', 'parentAdminId', 'createdAt'
          ])
        )
      );

      // Delete: Super Admin or self-account deletion
      allow delete: if isSuperAdmin() || isOwner(userId);

      // Saved payment methods subcollection
      match /payment_methods/{methodId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
    }

    // =========================================================================
    // 4. CUSTOMER SAVED ADDRESSES
    // =========================================================================
    match /addresses/{addressId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // =========================================================================
    // 5. CATEGORIES, MENU ITEMS & OPTION TEMPLATES
    // =========================================================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if canManage('categories');
    }

    match /menuItems/{menuItemId} {
      allow read: if true;
      allow write: if canManage('menu');
    }

    match /menu_items/{menuItemId} {
      allow read: if true;
      allow write: if canManage('menu');
    }

    match /option_templates/{templateId} {
      allow read: if true;
      allow write: if canManage('menu');
    }

    match /optionTemplates/{templateId} {
      allow read: if true;
      allow write: if canManage('menu');
    }

    // =========================================================================
    // 6. DEALS & PROMOTIONS (BRANCH-SCOPED ADMIN DEALS)
    // =========================================================================
    match /deals/{dealId} {
      allow read: if true;
      allow write: if canManage('deals') || canManage('coupons');
    }

    // =========================================================================
    // 7. ORDERS & LIFECYCLE
    // =========================================================================
    match /orders/{orderId} {
      // Read:
      // - Admin/Staff: all orders (or filtered by branch)
      // - Customer: their own orders (supports where('customerId', isEqualTo: auth.uid))
      // - Delivery Rider: assigned orders (supports where('riderId', isEqualTo: auth.uid))
      allow read: if isAdmin() ||
                     (isAuthenticated() && (resource == null || resource.data.customerId == request.auth.uid)) ||
                     (isDeliveryRider() && (
                       resource == null ||
                       resource.data.riderId == request.auth.uid ||
                       resource.data.get('rider_id', '') == request.auth.uid
                     ));

      // Create:
      // - Admin/Staff can place orders on behalf
      // - Customer can only create an order with their own customerId
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid
      );

      // Update:
      // - Admin/Staff: can update order statuses, assign riders, update financials
      // - Customer: can only cancel their own order (cannot alter prices or items)
      // - Delivery Rider: can only update delivery status & cancellation reason (cannot modify financials or items)
      allow update: if canManage('orders') ||
        (
          isAuthenticated() &&
          resource.data.customerId == request.auth.uid &&
          request.resource.data.customerId == request.auth.uid &&
          request.resource.data.total == resource.data.total &&
          request.resource.data.subtotal == resource.data.subtotal &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancellationReason', 'updatedAt']) &&
          request.resource.data.status == 'cancelled'
        ) ||
        (
          isDeliveryRider() &&
          (resource.data.riderId == request.auth.uid || resource.data.get('rider_id', '') == request.auth.uid) &&
          request.resource.data.customerId == resource.data.customerId &&
          request.resource.data.total == resource.data.total &&
          request.resource.data.subtotal == resource.data.subtotal &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'cancellationReason'])
        );

      allow delete: if isSuperAdmin();

      // Live GPS tracking subcollection (e.g. /orders/{orderId}/tracking/rider_live)
      match /tracking/{trackingId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isAuthenticated();
      }
    }

    match /orderItems/{itemId} {
      allow read: if isAuthenticated();
      allow write: if canManage('orders');
    }

    // =========================================================================
    // 8. DELIVERY AREAS
    // =========================================================================
    match /deliveryAreas/{areaId} {
      allow read: if true;
      allow write: if canManage('delivery_areas');
    }

    match /delivery_areas/{areaId} {
      allow read: if true;
      allow write: if canManage('delivery_areas');
    }

    // =========================================================================
    // 9. RIDERS & FLEET MANAGEMENT
    // =========================================================================
    match /riders/{riderId} {
      allow read: if isAuthenticated();
      allow create: if canManage('riders') || isAdmin();
      allow update: if canManage('riders') || isAdmin() || (
        isAuthenticated() &&
        (isOwner(riderId) || (resource != null && resource.data.userId == request.auth.uid))
      );
      allow delete: if isSuperAdmin();
    }

    match /riderAssignments/{assignmentId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.riderId == request.auth.uid));
      allow create: if canManage('riders') || isAdmin();
      allow update: if canManage('riders') || isAdmin() || (
        isAuthenticated() && resource.data.riderId == request.auth.uid
      );
      allow delete: if isSuperAdmin();
    }

    match /rider_locations/{riderId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (
        isAuthenticated() && isOwner(riderId)
      );
    }

    // =========================================================================
    // 10. COUPONS & PROMOTIONS
    // =========================================================================
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if canManage('coupons');
    }

    // =========================================================================
    // 11. SYSTEM SETTINGS
    // =========================================================================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 12. AUDIT LOGS (IMMUTABLE LOGS)
    // =========================================================================
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 13. REVIEWS & RATINGS
    // =========================================================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // =========================================================================
    // 14. NOTIFICATIONS
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid)
      );
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        (resource == null || resource.data.userId == request.auth.uid)
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // =========================================================================
    // 15. FAVORITES
    // =========================================================================
    match /favorites/{favoriteId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid)
      );
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // =========================================================================
    // 16. LOYALTY ACCOUNTS & TRANSACTIONS (REWARDS & WELCOME BONUS)
    // =========================================================================
    match /loyaltyAccounts/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create, update: if isAdmin() || isOwner(userId);
      allow delete: if isSuperAdmin();
    }

    match /loyalty_accounts/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create, update: if isAdmin() || isOwner(userId);
      allow delete: if isSuperAdmin();
    }

    match /loyaltyTransactions/{txId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid)
      );
      allow create: if isAdmin() || (
        isAuthenticated() && request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isSuperAdmin();
    }

    match /loyalty_transactions/{txId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid)
      );
      allow create: if isAdmin() || (
        isAuthenticated() && request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 17. CHATS & MESSAGES (REAL-TIME TWO-WAY SUPPORT & ORDER CHAT)
    // =========================================================================
    match /chats/{chatId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource == null ||
          resource.data.customerId == request.auth.uid ||
          resource.data.get('customerId', '') == request.auth.uid
        )
      );
      allow create: if isAuthenticated() && (
        request.resource.data.customerId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid
      );
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          request.resource.data.senderId == request.auth.uid ||
          isAdmin()
        );
        allow update, delete: if isAdmin();
      }
    }

    // =========================================================================
    // DEFAULT DENY FOR EVERYTHING ELSE
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
