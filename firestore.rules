rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & ROLE DEFINITIONS
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return userDocExists() ? getUserData().role : '';
    }

    function getUserBranchId() {
      return userDocExists() ? getUserData().branchId : '';
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role == 'super_admin') ||
        (getUserRole() == 'super_admin')
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.token != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'sub_admin' || request.auth.token.role == 'staff')) ||
        (getUserRole() == 'admin' || getUserRole() == 'sub_admin' || getUserRole() == 'staff')
      );
    }

    function isRider() {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role == 'rider') ||
        (getUserRole() == 'rider')
      );
    }

    // Branch isolation check: super admins have access to all branches;
    // admins and sub-admins only have access to their assigned branch.
    function isBranchAdmin(branchId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (isAdmin() && (branchId == null || branchId == '' || branchId == getUserBranchId()))
      );
    }

    // =========================================================================
    // 1. USERS & ACCOUNTS
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || isRider());
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      // Prevent normal clients from changing their own role or sensitive fields
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBlocked', 'tokens'])))
      );
      allow delete: if isSuperAdmin();

      match /payment_methods/{methodId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
    }

    // =========================================================================
    // 2. BRANCHES & RESTAURANTS
    // =========================================================================
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 3. CUSTOMER SAVED ADDRESSES
    // =========================================================================
    match /addresses/{addressId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource == null ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // =========================================================================
    // 4. CATEGORIES, MENU ITEMS & OPTION TEMPLATES
    // =========================================================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menuItems/{menuItemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menu_items/{menuItemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /option_templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /optionTemplates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 5. DEALS MODULE (Replaces Coupons for Customers)
    // =========================================================================
    match /deals/{dealId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 6. ORDERS & LIFECYCLE
    // =========================================================================
    match /orders/{orderId} {
      allow read: if isAdmin() || isRider() ||
                     (isAuthenticated() && resource.data.customerId == request.auth.uid) ||
                     (isAuthenticated() && resource.data.riderId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.customerId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || isRider() ||
                       (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow delete: if isSuperAdmin();

      match /tracking/{trackingId} {
        allow read: if isAuthenticated();
        allow write: if isRider() || isAdmin();
      }
    }

    match /orderItems/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 7. RIDERS & FLEET TRACKING
    // =========================================================================
    match /riders/{riderId} {
      allow read: if isAuthenticated() && (isAdmin() || isOwner(riderId) ||
                     (resource != null && resource.data.userId == request.auth.uid));
      allow create: if isAdmin();
      allow update: if isAdmin() || isOwner(riderId) || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    match /riderAssignments/{assignmentId} {
      allow read: if isAuthenticated() && (isAdmin() || isRider() || (resource != null && resource.data.riderId == request.auth.uid));
      allow write: if isAdmin() || isRider();
    }

    match /rider_locations/{riderId} {
      allow read: if isAuthenticated();
      allow write: if isRider() || isAdmin() || isOwner(riderId);
    }

    match /deliveryAreas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /delivery_areas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 8. LOYALTY TOKENS (Account & Transactions)
    // =========================================================================
    match /loyaltyAccounts/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    match /loyaltyTransactions/{txId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource == null ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 9. REVIEWS & RATINGS
    // =========================================================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // =========================================================================
    // 10. REAL-TIME CHAT (Customer <-> Admin per branch)
    // =========================================================================
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource == null ||
        resource.data.customerId == request.auth.uid ||
        (resource.data.assignedAdminId != null && resource.data.assignedAdminId == request.auth.uid) ||
        chatId.matches('support_' + request.auth.uid + '_.*') ||
        chatId.matches('order_.*')
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.customerId == request.auth.uid)
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid
      );
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          isAdmin() ||
          request.resource.data.senderId == request.auth.uid
        );
        allow update: if isAdmin();
        allow delete: if isSuperAdmin();
      }
    }

    // =========================================================================
    // 11. NOTIFICATIONS & FAVORITES
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (isAdmin() || (resource == null || resource.data.userId == request.auth.uid));
      allow write: if isAuthenticated() && (isAdmin() || (resource == null || resource.data.userId == request.auth.uid));
    }

    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && (isAdmin() || (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // =========================================================================
    // 12. PLATFORM SETTINGS & AUDIT LOGS
    // =========================================================================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }
  }
}
