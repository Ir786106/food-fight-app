# Build-time values used by optional image-storage integrations.
# Flutter does not load .env automatically; pass these values with --dart-define.
# Firebase Storage is the active upload provider by default.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SIGNED_SUPABASE_UPLOADS=false
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Configure Google Maps separately:
# Android: GOOGLE_MAPS_API_KEY in the ignored android/local.properties file.
# Web: window.foodFightGoogleMapsApiKey in the ignored web/maps-config.js file.

# Configure Cloud Function provider secrets in the server runtime, not here.
