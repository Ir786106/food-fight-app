    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "18"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.8.0",
    "@sendgrid/mail": "^8.1.0",
    "twilio": "^4.23.0",
    "nodemailer": "^6.9.10"
  },
  "private": true
}
