rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 0. AUTHENTICATION & SECURE ROLE HELPERS (DO NOT TRUST CLIENT-PROVIDED ROLE)
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function existingUser() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return existingUser() ? getUserData().get('role', '') : '';
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.get('role', '') == 'super_admin') ||
        getUserRole() == 'super_admin'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.token != null && (
          request.auth.token.get('role', '') == 'admin' ||
          request.auth.token.get('role', '') == 'sub_admin' ||
          request.auth.token.get('role', '') == 'staff'
        )) ||
        getUserRole() == 'admin' ||
        getUserRole() == 'sub_admin' ||
        getUserRole() == 'staff'
      );
    }

    function isDeliveryRider() {
      return isAuthenticated() && (
        (request.auth.token != null && (
          request.auth.token.get('role', '') == 'delivery_rider' ||
          request.auth.token.get('role', '') == 'rider'
        )) ||
        getUserRole() == 'delivery_rider' ||
        getUserRole() == 'rider'
      );
    }

    function isSubAdmin() {
      return existingUser() && (getUserRole() in ['sub_admin', 'staff'] || getUserData().get('parentAdminId', null) != null);
    }

    function hasPermission(perm) {
      return (
        getUserData().get('permissions', null) is list && (
          getUserData().get('permissions', []).hasAny([perm, 'manage_' + perm])
        )
      ) || (
        getUserData().get('permissions', null) is map && (
          getUserData().get('permissions', {}).get(perm, false) == true ||
          getUserData().get('permissions', {}).get('manage_' + perm, false) == true
        )
      );
    }

    function canManage(perm) {
      return isSuperAdmin() || (
        isAdmin() && (
          !isSubAdmin() || hasPermission(perm)
        )
      );
    }

    function getUserBranchId() {
      return (request.auth.token != null && request.auth.token.get('branchId', '') != '')
        ? request.auth.token.get('branchId', '')
        : (existingUser() ? getUserData().get('branchId', '') : '');
    }

    function isBranchStaffOrAdmin(branchId) {
      return isAdmin() && (isSuperAdmin() || getUserBranchId() == branchId);
    }

    function catalogBelongsToCaller(data) {
      let branch = getUserBranchId();
      return branch is string && branch != '' &&
        data.get('branchId', data.get('branch_id', '')) == branch &&
        data.get('branch_id', branch) == branch;
    }

    function incomingRole() {
      return request.resource.data.get('role', '');
    }

    function existingRole() {
      return resource.data.get('role', '');
    }


    // =========================================================================
    // 1. BRANCHES & MULTI-LOCATION
    // =========================================================================
    match /branches/{branchId} {
      allow read: if true;
      allow create: if isSuperAdmin();
      // Super Admin, Branch Admin, or authenticated orders updating branch financial counters
      allow update: if isSuperAdmin() ||
                       (isAdmin() && !isSubAdmin() && getUserData().get('branchId', '') == branchId);
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 2. RESTAURANTS
    // =========================================================================
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if isSuperAdmin() || canManage('restaurants');
    }

    // =========================================================================
    // 3. USERS & ACCOUNTS (STRICT ROLE PRIVILEGES)
    // =========================================================================
    match /users/{userId} {
      // Riders get delivery contact details from their assigned order.
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        isSuperAdmin() ||
        (isAdmin() && (resource.data.get('branchId', '') == getUserBranchId() || resource.data.get('role', '') == 'customer'))
      );

      // Create:
      // - Customer self-signup: only allowed with role == 'customer' and no elevated flags
      // - Admin: can create staff/customer, CANNOT create super_admin
      // - Super Admin: full creation rights
      allow create: if (
        (
          isOwner(userId) &&
          (incomingRole() == 'customer' || incomingRole() == '') &&
          request.resource.data.get('permissions', null) == null &&
          request.resource.data.get('isAdmin', false) == false &&
          request.resource.data.get('isSuperAdmin', false) == false
        ) ||
        isSuperAdmin() ||
        (
          isAdmin() &&
          !isSubAdmin() &&
          incomingRole() != 'super_admin'
        )
      );

      // Update:
      // - Super Admin: full update rights
      // - Admin: manage users/staff (cannot modify super_admin, cannot promote to super_admin)
      // - Customer: can update only safe profile fields (cannot change role, status, branch, permissions)
      allow update: if (
        isSuperAdmin() ||
        (
          isAdmin() &&
          canManage('customers') && existingRole() == 'customer' && incomingRole() == 'customer' &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'parentAdminId', 'branchId', 'isAdmin', 'isSuperAdmin'])
        ) ||
        (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'permissions', 'status', 'isActive', 'isBlocked', 'isAdmin', 'isSuperAdmin',
            'branchId', 'parentAdminId', 'createdAt'
          ])
        )
      );

      // Keep blocked profiles so the same account cannot recreate an active profile.
      allow delete: if isSuperAdmin() || (isOwner(userId) &&
        resource.data.get('isActive', null) in [null, true, 1, 'true', '1'] &&
        resource.data.get('isBlocked', false) != true &&
        resource.data.get('status', '') != 'blocked');

      // Saved payment methods subcollection
      match /payment_methods/{methodId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
    }

    // =========================================================================
    // 4. CUSTOMER SAVED ADDRESSES
    // =========================================================================
    match /addresses/{addressId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // =========================================================================
    // 5. CATEGORIES, MENU ITEMS & OPTION TEMPLATES
    // =========================================================================
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isSuperAdmin() ||
        (canManage('categories') && catalogBelongsToCaller(request.resource.data));
      allow update: if isSuperAdmin() ||
        (canManage('categories') && catalogBelongsToCaller(resource.data) &&
          catalogBelongsToCaller(request.resource.data));
      allow delete: if isSuperAdmin() ||
        (canManage('categories') && catalogBelongsToCaller(resource.data));
    }

    match /menuItems/{menuItemId} {
      allow read: if true;
      allow create: if isSuperAdmin() ||
        (canManage('menu') && catalogBelongsToCaller(request.resource.data));
      allow update: if isSuperAdmin() ||
        (canManage('menu') && catalogBelongsToCaller(resource.data) &&
          catalogBelongsToCaller(request.resource.data));
      allow delete: if isSuperAdmin() ||
        (canManage('menu') && catalogBelongsToCaller(resource.data));
    }

    match /menu_items/{menuItemId} {
      allow read: if true;
      allow create: if isSuperAdmin() ||
        (canManage('menu') && catalogBelongsToCaller(request.resource.data));
      allow update: if isSuperAdmin() ||
        (canManage('menu') && catalogBelongsToCaller(resource.data) &&
          catalogBelongsToCaller(request.resource.data));
      allow delete: if isSuperAdmin() ||
        (canManage('menu') && catalogBelongsToCaller(resource.data));
    }

    match /option_templates/{templateId} {
      allow read: if true;
      allow write: if canManage('menu');
    }

    match /optionTemplates/{templateId} {
      allow read: if true;
      allow write: if canManage('menu');
    }

    // =========================================================================
    // 6. DEALS & PROMOTIONS (BRANCH-SCOPED ADMIN DEALS)
    // =========================================================================
    match /deals/{dealId} {
      allow read: if true;
      allow write: if canManage('deals') || canManage('coupons');
    }

    // =========================================================================
    // 7. ORDERS & LIFECYCLE
    // =========================================================================
    match /orders/{orderId} {
      function staff() {
        return isSuperAdmin() || (canManage('orders') && resource.data.get('branchId', '') == getUserBranchId());
      }
      function rider() { return isDeliveryRider() && resource.data.get('riderId', '') == request.auth.uid; }
      allow read: if staff() || (isAuthenticated() && resource.data.customerId == request.auth.uid) || rider();
      allow write: if false;
            match /tracking/{trackingId} {
        function order() { return get(/databases/$(database)/documents/orders/$(orderId)).data; }
        allow read: if isAuthenticated() && (order().customerId == request.auth.uid ||
          order().get('riderId','') == request.auth.uid || isSuperAdmin() ||
          (canManage('orders') && order().branchId == getUserBranchId()));
        allow create, update: if isDeliveryRider() && order().get('riderId','') == request.auth.uid &&
          (order().status in ['pickedUp','outForDelivery'] || request.resource.data.get('isActive', true) == false);
        allow delete: if isSuperAdmin();
      }
    }

    match /menuReports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid &&
        request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 2000;
      allow read, update: if canManage('menu') && (isSuperAdmin() || resource.data.branchId == getUserBranchId());
      allow delete: if isSuperAdmin();
    }

    match /orderItems/{itemId} {
      allow read: if isAuthenticated();
      allow write: if canManage('orders');
    }

    // =========================================================================
    // 8. DELIVERY AREAS
    // =========================================================================
    match /deliveryAreas/{areaId} {
      allow read: if true;
      allow write: if canManage('delivery_areas');
    }

    match /delivery_areas/{areaId} {
      allow read: if true;
      allow write: if canManage('delivery_areas');
    }

    // =========================================================================
    // 9. RIDERS & FLEET MANAGEMENT
    // =========================================================================
    match /riders/{riderId} {
      allow read: if isAuthenticated();
      allow create: if canManage('riders');
      allow update: if canManage('riders') || (
        isAuthenticated() &&
        (isOwner(riderId) || (resource != null && resource.data.userId == request.auth.uid)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOnline','updatedAt','lastSeen'])
      );
      allow delete: if isSuperAdmin();
    }

    match /riderAssignments/{assignmentId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.riderId == request.auth.uid));
      allow write: if false;
    }

    match /rider_locations/{riderId} {
      allow read: if isOwner(riderId) || canManage('riders');
      allow write: if isAdmin() || (
        isAuthenticated() && isOwner(riderId)
      );
    }

    // =========================================================================
    // 10. COUPONS & PROMOTIONS
    // =========================================================================
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if canManage('coupons');
    }

    // =========================================================================
    // 11. SYSTEM SETTINGS
    // =========================================================================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 12. AUDIT LOGS (IMMUTABLE LOGS)
    // =========================================================================
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || (isAdmin() && (resource.data.get('branchId', '') == '' || resource.data.get('branchId', '') == getUserBranchId()));
      allow create: if isSuperAdmin() || (isAdmin() && (request.resource.data.get('branchId', '') == '' || request.resource.data.get('branchId', '') == getUserBranchId()));
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 13. REVIEWS & RATINGS
    // =========================================================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if false;
      allow update: if canManage('reviews') && (isSuperAdmin() || resource.data.branchId == getUserBranchId()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isHidden','adminReply','updatedAt']);
      allow delete: if isSuperAdmin() || isOwner(resource.data.userId);
    }

    // =========================================================================
    // 14. NOTIFICATIONS
    // =========================================================================
    match /notifications/{notificationId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) && request.resource.data.isRead in [0,1,true,false];
    }

    // =========================================================================
    // 15. FAVORITES
    // =========================================================================
    match /favorites/{favoriteId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid)
      );
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // =========================================================================
    // =========================================================================
    // 16. LOYALTY ACCOUNTS & TRANSACTIONS (REWARDS & WELCOME BONUS)
    // =========================================================================
    match /loyaltyAccounts/{userId} {
      allow read: if isOwner(userId) || canManage('customers');
      allow write: if false;
    }

    match /loyalty_accounts/{userId} {
      allow read: if isOwner(userId) || canManage('customers');
      allow write: if false;
    }

    match /loyaltyTransactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || canManage('customers'));
      allow write: if false;
    }

    match /loyalty_transactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || canManage('customers'));
      allow write: if false;
    }

    // =========================================================================
    // 17. CHATS & MESSAGES (REAL-TIME TWO-WAY SUPPORT & ORDER CHAT)
    // =========================================================================
    match /chats/{chatId} {
      function access(data) {
        return isAuthenticated() && (data.customerId == request.auth.uid || isSuperAdmin() ||
          (canManage('chats') && data.get('branchId','') == getUserBranchId()));
      }
      allow get: if isAuthenticated() && (resource == null || access(resource.data));
      allow list: if access(resource.data);
      allow create: if access(request.resource.data) && request.resource.data.get('unreadForAdmin',0) == 0 &&
        request.resource.data.get('unreadForCustomer',0) == 0;
      allow update: if access(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage','lastMessageAt','lastSenderRole','unreadForAdmin','unreadForCustomer','updatedAt','status','assignedAdminId']) &&
        (canManage('chats') || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedAdminId']));
      allow delete: if isSuperAdmin();
      match /messages/{messageId} {
        function parent() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        allow read: if access(parent());
        allow create: if access(parent()) && request.resource.data.senderId == request.auth.uid &&
          ((parent().customerId == request.auth.uid && request.resource.data.senderRole == 'customer') ||
            (canManage('chats') && request.resource.data.senderRole != 'customer'));
        allow update: if access(parent()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
          request.resource.data.readBy.hasAll(resource.data.get('readBy', [])) &&
          request.resource.data.readBy.toSet().difference(resource.data.get('readBy', []).toSet()).hasOnly([request.auth.uid]);
        allow delete: if isSuperAdmin();
      }
    }

    // =========================================================================
    // 17B. RESTAURANT BRANCHES
    // =========================================================================
    match /branches/{branchId} {
      // Anyone (customers, guests, authenticated users) can read branches & coordinates
      allow read: if true;
      // Only Super Admin can write/create/update/delete branch configuration
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 18. SYSTEM SETTINGS & APP UPDATE CONFIGURATION
    // =========================================================================
    match /settings/app_update {
      // Public read for in-app version checks and force-update enforcement
      allow read: if true;
      // Super admin only write
      allow write: if isSuperAdmin();
    }

    match /settings/{settingId} {
      // Authenticated users can read general platform settings
      allow read: if isAuthenticated();
      // Super admin only write
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // DEFAULT DENY FOR EVERYTHING ELSE
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
