rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 0. AUTHENTICATION & SECURE ROLE HELPERS (DO NOT TRUST CLIENT-PROVIDED ROLE)
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function existingUser() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return existingUser() ? getUserData().get('role', '') : '';
    }

    function hasActiveProfile() {
      return existingUser() &&
        getUserData().get('isActive', null) in [null, true, 1, 'true', '1'] &&
        getUserData().get('isBlocked', false) != true &&
        !(getUserData().get('status', '') in ['blocked', 'suspended', 'deactivated']);
    }

    function isSuperAdmin() {
      return hasActiveProfile() && getUserRole() == 'super_admin';
    }

    function isAdmin() {
      return hasActiveProfile() && getUserRole() in ['super_admin', 'admin', 'sub_admin', 'staff'];
    }
    function isDeliveryRider() {
      return hasActiveProfile() && getUserRole() in ['delivery_rider', 'rider'];
    }
    function isSubAdmin() {
      return existingUser() && (getUserRole() in ['sub_admin', 'staff'] || getUserData().get('parentAdminId', null) != null);
    }

    function hasPermission(perm) {
      return (
        getUserData().get('permissions', null) is list && (
          getUserData().get('permissions', []).hasAny([perm, 'manage_' + perm])
        )
      ) || (
        getUserData().get('permissions', null) is map && (
          getUserData().get('permissions', {}).get(perm, false) == true ||
          getUserData().get('permissions', {}).get('manage_' + perm, false) == true
        )
      );
    }

    function canManage(perm) {
      return isAdmin() && (getUserRole() == 'super_admin' || !isSubAdmin() || hasPermission(perm));
    }

    function canManageDeals() {
      return isAdmin() && (getUserRole() == 'super_admin' || !isSubAdmin() ||
        hasPermission('deals') || hasPermission('coupons'));
    }
    function getUserBranchId() {
      return existingUser()
        ? getUserData().get('branchId', '')
        : (isAuthenticated() ? request.auth.token.get('branchId', '') : '');
    }
    function matchesAssignedBranch(branchId) {
      return branchId is string && branchId != '' && branchId != 'all' &&
        branchId == getUserBranchId();
    }

    function hasOrderBranchAccess(branchId) {
      return canManage('orders') && matchesAssignedBranch(branchId);
    }

    function catalogBelongsToCaller(data) {
      let branch = getUserBranchId();
      return branch is string && branch != '' && branch != 'all' &&
        data.get('branchId', data.get('branch_id', '')) == branch &&
        data.get('branch_id', branch) == branch;
    }

    function incomingRole() {
      return request.resource.data.get('role', '');
    }

    function existingRole() {
      return resource.data.get('role', '');
    }


    // =========================================================================
    // 1. BRANCHES & MULTI-LOCATION
    // =========================================================================
    match /branches/{branchId} {
      function financialFields() {
        return ['revenue', 'expenses', 'orderCount', 'ordersCount', 'totalRevenue', 'totalOrders'];
      }
      allow read: if true;
      allow create: if isSuperAdmin() &&
        !request.resource.data.keys().hasAny(financialFields());
      // Super Admin, Branch Admin, or authenticated orders updating branch financial counters
      allow update: if (isSuperAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(financialFields())) ||
                       (isAdmin() && !isSubAdmin() && matchesAssignedBranch(branchId) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'name', 'address', 'phone', 'openingHours', 'updatedAt'
                         ]));
      allow delete: if isSuperAdmin();
    }

    match /branchMetrics/{branchId} {
      allow read: if isSuperAdmin() ||
        (canManage('reports') && matchesAssignedBranch(branchId));
      allow write: if false;
    }

    // =========================================================================
    // 2. RESTAURANTS
    // =========================================================================
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 3. USERS & ACCOUNTS (STRICT ROLE PRIVILEGES)
    // =========================================================================
    match /users/{userId} {
      // Riders get delivery contact details from their assigned order.
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        isSuperAdmin() ||
        (isAdmin() && matchesAssignedBranch(resource.data.get('branchId', '')) &&
         resource.data.get('role', '') in ['admin', 'sub_admin', 'staff', 'rider', 'delivery_rider'])
      );

      // Privileged profiles are provisioned by Auth-backed Cloud Functions.
      allow create: if (
        isOwner(userId) &&
        (incomingRole() == 'customer' || (isOwner(userId) && incomingRole() == '')) &&
        request.resource.data.get('permissions', null) == null &&
        request.resource.data.get('isAdmin', false) == false &&
        request.resource.data.get('isSuperAdmin', false) == false
      );
      allow update: if (
        (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'permissions', 'status', 'isActive', 'isBlocked', 'isAdmin', 'isSuperAdmin',
            'branchId', 'parentAdminId', 'createdAt'
          ])
        )
      );

      // Keep blocked profiles so the same account cannot recreate an active profile.
      allow delete: if (existingRole() in ['customer', ''] && (isSuperAdmin() || isOwner(userId)) &&
        resource.data.get('isActive', null) in [null, true, 1, 'true', '1'] &&
        resource.data.get('isBlocked', false) != true &&
        resource.data.get('status', '') != 'blocked');

      // Saved payment methods subcollection
      match /payment_methods/{methodId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
    }

    // =========================================================================
    // 4. CUSTOMER SAVED ADDRESSES
    // =========================================================================
    match /addresses/{addressId} {
      allow get: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow list, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
    }

    // =========================================================================
    // 5. CATEGORIES, MENU ITEMS & OPTION TEMPLATES
    // =========================================================================
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isSuperAdmin() ||
        (canManage('categories') && catalogBelongsToCaller(request.resource.data));
      allow update: if isSuperAdmin() ||
        (canManage('categories') && catalogBelongsToCaller(resource.data) &&
          catalogBelongsToCaller(request.resource.data));
      allow delete: if isSuperAdmin() ||
        (canManage('categories') && catalogBelongsToCaller(resource.data));
    }

    match /menuItems/{menuItemId} {
      allow read: if true;
      allow create: if isSuperAdmin() ||
        (canManage('menu') && catalogBelongsToCaller(request.resource.data));
      allow update: if isSuperAdmin() ||
        (canManage('menu') && catalogBelongsToCaller(resource.data) &&
          catalogBelongsToCaller(request.resource.data));
      allow delete: if isSuperAdmin() ||
        (canManage('menu') && catalogBelongsToCaller(resource.data));
    }

    match /menu_items/{menuItemId} {
      allow read: if true;
      allow create: if isSuperAdmin() ||
        (canManage('menu') && catalogBelongsToCaller(request.resource.data));
      allow update: if isSuperAdmin() ||
        (canManage('menu') && catalogBelongsToCaller(resource.data) &&
          catalogBelongsToCaller(request.resource.data));
      allow delete: if isSuperAdmin() ||
        (canManage('menu') && catalogBelongsToCaller(resource.data));
    }

    match /option_templates/{templateId} {
      allow read: if true;
      allow create: if isSuperAdmin() ||
        (canManage('menu') && catalogBelongsToCaller(request.resource.data));
      allow update: if isSuperAdmin() ||
        (canManage('menu') && catalogBelongsToCaller(resource.data) &&
         catalogBelongsToCaller(request.resource.data));
      allow delete: if isSuperAdmin() ||
        (canManage('menu') && catalogBelongsToCaller(resource.data));
    }

    match /optionTemplates/{templateId} {
      allow read: if true;
      allow create: if isSuperAdmin() ||
        (canManage('menu') && catalogBelongsToCaller(request.resource.data));
      allow update: if isSuperAdmin() ||
        (canManage('menu') && catalogBelongsToCaller(resource.data) &&
         catalogBelongsToCaller(request.resource.data));
      allow delete: if isSuperAdmin() ||
        (canManage('menu') && catalogBelongsToCaller(resource.data));
    }

    // =========================================================================
    // 6. DEALS & PROMOTIONS (BRANCH-SCOPED ADMIN DEALS)
    // =========================================================================
    match /deals/{dealId} {
      allow read: if true;
      allow create: if isSuperAdmin() ||
        (canManageDeals() && catalogBelongsToCaller(request.resource.data));
      allow update: if isSuperAdmin() ||
        (canManageDeals() && catalogBelongsToCaller(resource.data) &&
         catalogBelongsToCaller(request.resource.data));
      allow delete: if isSuperAdmin() ||
        (canManageDeals() && catalogBelongsToCaller(resource.data));
    }

    // =========================================================================
    // 7. ORDERS & LIFECYCLE
    // =========================================================================
    match /orders/{orderId} {
      function staff() {
        return isSuperAdmin() || hasOrderBranchAccess(resource.data.get('branchId', ''));
      }
      function rider() { return isDeliveryRider() && resource.data.get('riderId', '') == request.auth.uid; }
      allow read: if staff() || (isAuthenticated() && resource.data.customerId == request.auth.uid) || rider();
      allow write: if false;
            match /tracking/{trackingId} {
        function order() { return get(/databases/$(database)/documents/orders/$(orderId)).data; }
        allow read: if isAuthenticated() && (order().customerId == request.auth.uid ||
          order().get('riderId','') == request.auth.uid || isSuperAdmin() ||
          hasOrderBranchAccess(order().get('branchId', '')));
        allow create, update: if isDeliveryRider() && order().get('riderId','') == request.auth.uid &&
          (order().status in ['pickedUp','outForDelivery'] || request.resource.data.get('isActive', true) == false);
        allow delete: if isSuperAdmin();
      }
    }

    match /menuReports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid &&
        request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 2000;
      allow read: if canManage('menu') && (isSuperAdmin() || matchesAssignedBranch(resource.data.get('branchId', '')));
      allow update: if canManage('menu') &&
        (isSuperAdmin() || matchesAssignedBranch(resource.data.get('branchId', ''))) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy']) &&
        request.resource.data.status in ['open', 'resolved'] &&
        request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isSuperAdmin();
    }

    match /orderItems/{itemId} {
      function canReadParent(orderId) {
        let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
        return order.customerId == request.auth.uid ||
          (isDeliveryRider() && order.get('riderId', '') == request.auth.uid) ||
          hasOrderBranchAccess(order.get('branchId', ''));
      }
      allow read: if isSuperAdmin() || (isAuthenticated() &&
        resource.data.get('orderId', '') != '' && canReadParent(resource.data.orderId));
      allow write: if false;
    }

    // =========================================================================
    // 8. DELIVERY AREAS
    // =========================================================================
    match /deliveryAreas/{areaId} {
      allow read: if true;
      allow create: if isSuperAdmin() ||
        (canManage('delivery_areas') && catalogBelongsToCaller(request.resource.data));
      allow update: if isSuperAdmin() ||
        (canManage('delivery_areas') && catalogBelongsToCaller(resource.data) &&
         catalogBelongsToCaller(request.resource.data));
      allow delete: if isSuperAdmin() ||
        (canManage('delivery_areas') && catalogBelongsToCaller(resource.data));
    }

    match /delivery_areas/{areaId} {
      allow read: if true;
      allow create: if isSuperAdmin() ||
        (canManage('delivery_areas') && catalogBelongsToCaller(request.resource.data));
      allow update: if isSuperAdmin() ||
        (canManage('delivery_areas') && catalogBelongsToCaller(resource.data) &&
         catalogBelongsToCaller(request.resource.data));
      allow delete: if isSuperAdmin() ||
        (canManage('delivery_areas') && catalogBelongsToCaller(resource.data));
    }

    // =========================================================================
    // 9. RIDERS & FLEET MANAGEMENT
    // =========================================================================
    match /riders/{riderId} {
      allow read: if isSuperAdmin() || ((canManage('riders') || canManage('orders')) &&
         matchesAssignedBranch(resource.data.get('branchId', ''))) ||
        (isDeliveryRider() && (isOwner(riderId) || resource.data.get('userId', '') == request.auth.uid));
      allow create: if isSuperAdmin() ||
        (canManage('riders') && catalogBelongsToCaller(request.resource.data));
      allow update: if isSuperAdmin() ||
        (canManage('riders') && catalogBelongsToCaller(resource.data) &&
         catalogBelongsToCaller(request.resource.data) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId'])) ||
        (isDeliveryRider() && (isOwner(riderId) || resource.data.get('userId', '') == request.auth.uid) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOnline','updatedAt','lastSeen']));
      allow delete: if isSuperAdmin();
    }

    match /riderAssignments/{assignmentId} {
      allow read: if isSuperAdmin() ||
        (isDeliveryRider() && resource.data.riderId == request.auth.uid) ||
        (resource.data.get('orderId', '') != '' &&
         hasOrderBranchAccess(get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.get('branchId', '')));
      allow write: if false;
    }

    match /rider_locations/{riderId} {
      allow read: if isSuperAdmin() || (isDeliveryRider() && isOwner(riderId));
      allow write: if isDeliveryRider() && isOwner(riderId);
    }
    // =========================================================================
    // 10. COUPONS & PROMOTIONS
    // =========================================================================
    match /coupons/{couponId} {
      allow read: if true;
      allow create: if isSuperAdmin() ||
        (canManage('coupons') && catalogBelongsToCaller(request.resource.data));
      allow update: if isSuperAdmin() ||
        (canManage('coupons') && catalogBelongsToCaller(resource.data) &&
         catalogBelongsToCaller(request.resource.data));
      allow delete: if isSuperAdmin() ||
        (canManage('coupons') && catalogBelongsToCaller(resource.data));
    }

    // =========================================================================
    // 11. SYSTEM SETTINGS
    // =========================================================================
    match /settings/{settingId} {
      allow read: if settingId == 'global_settings' || isSuperAdmin();
      allow write: if settingId != 'global_settings' && isSuperAdmin();
    }

    // =========================================================================
    // 12. AUDIT LOGS (IMMUTABLE LOGS)
    // =========================================================================
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || (isAdmin() && matchesAssignedBranch(resource.data.get('branchId', '')));
      allow write: if false;
    }
    // =========================================================================
    // 13. REVIEWS & RATINGS
    // =========================================================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if false;
      allow update: if canManage('reviews') && (isSuperAdmin() || matchesAssignedBranch(resource.data.get('branchId', ''))) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isHidden','adminReply','updatedAt']);
      allow delete: if isSuperAdmin() || isOwner(resource.data.userId);
    }

    // =========================================================================
    // 14. NOTIFICATIONS
    // =========================================================================
    match /notifications/{notificationId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) && request.resource.data.isRead in [0,1,true,false];
    }

    // =========================================================================
    // 15. FAVORITES
    // =========================================================================
    match /favorites/{favoriteId} {
      allow get: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow list, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
    }

    // =========================================================================
    // =========================================================================
    // 16. LOYALTY ACCOUNTS & TRANSACTIONS (REWARDS & WELCOME BONUS)
    // =========================================================================
    match /loyaltyAccounts/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if false;
    }

    match /loyalty_accounts/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if false;
    }

    match /loyaltyTransactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow write: if false;
    }

    match /loyalty_transactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow write: if false;
    }

    // =========================================================================
    // 17. CHATS & MESSAGES (REAL-TIME TWO-WAY SUPPORT & ORDER CHAT)
    // =========================================================================
    match /chats/{chatId} {
      function managesBranchChat(data) {
        return matchesAssignedBranch(data.get('branchId', '')) && canManage('chats');
      }
      function managesChat(data) {
        return managesBranchChat(data) || isSuperAdmin();
      }
      function access(data) {
        return isAuthenticated() && (data.customerId == request.auth.uid || managesChat(data));
      }
      allow get: if isAuthenticated() && (resource == null || access(resource.data));
      allow list: if access(resource.data);
      allow create: if access(request.resource.data) && request.resource.data.get('unreadForAdmin',0) == 0 &&
        request.resource.data.get('unreadForCustomer',0) == 0;
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage','lastMessageAt','lastSenderRole','unreadForAdmin','unreadForCustomer','updatedAt','status','assignedAdminId']) &&
        ((isOwner(resource.data.customerId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedAdminId'])) ||
          managesChat(resource.data));
      allow delete: if isSuperAdmin();
      match /messages/{messageId} {
        function parent() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        allow read: if access(parent());
        allow create: if isOwner(request.resource.data.senderId) &&
          ((request.resource.data.senderRole == 'customer' && isOwner(parent().customerId)) ||
           (request.resource.data.senderRole == 'admin' && managesBranchChat(parent())) ||
           (request.resource.data.senderRole == 'super_admin' && isSuperAdmin()));
        allow update: if access(parent()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
          request.resource.data.readBy.hasAll(resource.data.get('readBy', [])) &&
          request.resource.data.readBy.toSet().difference(resource.data.get('readBy', []).toSet()).hasOnly([request.auth.uid]);
        allow delete: if isSuperAdmin();
      }
    }

    // =========================================================================
    // 18. SYSTEM SETTINGS & APP UPDATE CONFIGURATION
    // =========================================================================
    match /settings/app_update {
      // Public read for in-app version checks and force-update enforcement
      allow read: if true;
      // Super admin only write
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // DEFAULT DENY FOR EVERYTHING ELSE
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
