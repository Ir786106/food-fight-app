rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & ROLE DEFINITIONS
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return userDocExists() ? getUserData().role : '';
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role == 'super_admin') ||
        (getUserRole() == 'super_admin')
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.token != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'staff')) ||
        (getUserRole() == 'admin' || getUserRole() == 'staff')
      );
    }

    function isRider() {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role == 'rider') ||
        (getUserRole() == 'rider')
      );
    }

    // =========================================================================
    // 1. USERS & ACCOUNTS
    // =========================================================================
    // Customers can read and update their own document.
    // Admins and Super Admins can list and manage all user accounts.
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || isRider());
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isSuperAdmin();

      // -----------------------------------------------------------------------
      // PAYMENT METHODS SUBCOLLECTION
      // -----------------------------------------------------------------------
      // Customers can manage their own saved payment methods.
      // Admins can read (for support/debugging).
      match /payment_methods/{methodId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create: if isAuthenticated() && isOwner(userId);
        allow update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
    }

    // =========================================================================
    // 2. CUSTOMER SAVED ADDRESSES
    // =========================================================================
    // List: Customers can list only their own addresses (query must filter by userId).
    // Admin can list all addresses for support.
    // Single-doc read/write guarded by userId ownership or admin role.
    match /addresses/{addressId} {
      // For list queries: allow if user is admin, or if the query filters by userId == caller
      // For single-doc reads: allow if userId matches caller or admin
      allow read: if isAuthenticated() && (isAdmin() || (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // 3. CATEGORIES & MENU ITEMS
    // =========================================================================
    // Public read so anyone can view food menu. Admin & Super Admin write.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menuItems/{menuItemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menu_items/{menuItemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 4. ORDERS & LIFECYCLE
    // =========================================================================
    // - Customers can read and create their own orders.
    // - Customers can update (cancel) their pending order within allowed window.
    // - Admins and Super Admins have full access to manage and advance orders.
    // - Assigned Riders can read and update orders assigned to them.
    match /orders/{orderId} {
      allow read: if isAdmin() || isRider() ||
                     (isAuthenticated() && resource.data.customerId == request.auth.uid) ||
                     (isAuthenticated() && resource.data.riderId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.customerId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || isRider() ||
                       (isAuthenticated() && resource.data.customerId == request.auth.uid) ||
                       (isAuthenticated() && resource.data.riderId == request.auth.uid);
      allow delete: if isSuperAdmin();

      // Tracking subcollection for live GPS updates during delivery
      match /tracking/{trackingId} {
        allow read: if isAuthenticated();
        allow write: if isRider() || isAdmin();
      }
    }

    match /orderItems/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 5. DELIVERY AREAS & RIDERS
    // =========================================================================
    match /deliveryAreas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /delivery_areas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /riders/{riderId} {
      allow read: if isAuthenticated() && (isAdmin() || isOwner(riderId) ||
                     (resource != null && resource.data.userId == request.auth.uid));
      allow create: if isAdmin();
      allow update: if isAdmin() || isOwner(riderId) || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    match /riderAssignments/{assignmentId} {
      allow read: if isAuthenticated() && (isAdmin() || isRider() || (resource != null && resource.data.riderId == request.auth.uid));
      allow write: if isAdmin() || isRider();
    }

    match /rider_locations/{riderId} {
      allow read: if isAuthenticated();
      allow write: if isRider() || isAdmin() || isOwner(riderId);
    }

    // =========================================================================
    // 6. COUPONS & PROMOTIONS
    // =========================================================================
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 7. PLATFORM SETTINGS & CONFIGURATION
    // =========================================================================
    // Read: All authenticated and public users (store open/closed, delivery rules)
    // Write: Admin and Super Admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 8. SYSTEM AUDIT & ACTIVITY LOGS
    // =========================================================================
    // Read: Admin and Super Admin
    // Create: Any authenticated user (app event logging)
    // Update/Delete: Super Admin only
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 9. REVIEWS
    // =========================================================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // =========================================================================
    // 10. NOTIFICATIONS
    // =========================================================================
    // Customers can read their own notifications (query must filter by userId).
    // Admins can read all and write (send notifications).
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (isAdmin() || (resource == null || resource.data.userId == request.auth.uid));
      allow write: if isAdmin();
    }

    // =========================================================================
    // 11. FAVORITES
    // =========================================================================
    // Customers can read/write their own favorites (query must filter by userId).
    // Admins can read all.
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && (isAdmin() || (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
    }
  }
}
